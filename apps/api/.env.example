# Prisma / Postgres (depend de infra/docker-compose.yml)
DATABASE_URL=postgresql://reborn:reborn_dev_password_change_me@localhost:5432/reborn?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000

# JWT (HS256 pour le dev — migrer vers RS256 avant prod, cf §3.3)
# Generer un secret fort : openssl rand -base64 64
JWT_SECRET=dev-jwt-secret-change-me-please-use-openssl-rand-base64-64-in-prod
JWT_ISSUER=reborn-rp
JWT_AUDIENCE=reborn-launcher
JWT_ACCESS_TTL=15m

# 2FA (TOTP) — chiffrement des secrets au repos (AES-256-GCM)
# Cle de 32 bytes en hex (64 caracteres) ou base64. Generer : openssl rand -hex 32
# OBLIGATOIRE en production (NODE_ENV=production) — son absence fait planter le boot.
# En dev/test, un fallback est utilise si la variable est absente.
REBORN_2FA_ENC_KEY=

# Upload d'images (POST /v1/upload — screenshots whitelist/tickets).
# Dossier de stockage local. Defaut : <cwd>/uploads (= apps/api/uploads quand
# l'API tourne avec cwd = apps/api). Cree au boot si absent.
REBORN_UPLOAD_DIR=
# Base publique de l'API pour construire l'URL absolue retournee ({ url }).
# Les fichiers sont servis en lecture publique sous <base>/uploads/<filename>.
REBORN_PUBLIC_API_URL=http://localhost:3000
# Plafond de taille d'upload en octets (defaut ~8 MiB = 8388608).
REBORN_UPLOAD_MAX_BYTES=8388608
