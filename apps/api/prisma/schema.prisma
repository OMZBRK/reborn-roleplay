// Reborn Roleplay — schema Prisma
// Source de verite : PLAN_CONCEPTION_LAUNCHER.md §5.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  msAccountId       String   @unique
  minecraftUuid     String   @unique
  minecraftUsername String
  email             String?  @unique
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime?

  // Liaison Discord
  discordUserId     String?  @unique
  discordUsername   String?
  discordLinkedAt   DateTime?

  // Liaison Steam (optionnelle)
  steamId           String?  @unique
  steamUsername     String?
  steamLinkedAt     DateTime?

  // Liaison Twitch (optionnelle, pour streamers)
  twitchUserId      String?  @unique
  twitchUsername    String?
  twitchLinkedAt    DateTime?

  // Profil
  displayName       String?
  avatarUrl         String?

  // Preferences
  newsletterOptIn   Boolean  @default(false)
  notifEvents       Boolean  @default(true)
  notifFriends      Boolean  @default(true)
  notifTickets      Boolean  @default(true)
  richPresenceOn    Boolean  @default(true)
  language          String   @default("fr")

  // Marqueurs de lecture pour les compteurs non-lus (cloche + sidebar).
  // null = jamais consulté → tout est considéré comme non-lu.
  ticketsReadAt     DateTime?
  patchnotesReadAt  DateTime?

  // Monnaie virtuelle
  zkCoinBalance     Int      @default(0)

  role              Role     @default(PLAYER)
  banned            Boolean  @default(false)
  banReason         String?
  bannedUntil       DateTime?

  // Securite
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  lastKnownIp       String?
  lastKnownCountry  String?

  whitelistApp      WhitelistApplication?
  tickets           Ticket[]
  purchases         Purchase[]
  sessions          Session[]
  incidents         IntegrityIncident[]
  staffActions      AuditLog[] @relation("StaffActor")
  targetedActions   AuditLog[] @relation("TargetUser")

  // Cas/tickets actuellement assignes a ce staff (cf C3/C4 — bot DM flow).
  assignedWhitelists WhitelistApplication[] @relation("WhitelistAssignee")
  assignedTickets    Ticket[]               @relation("TicketAssignee")

  // L5 — creneaux oraux de whitelist : ceux ouverts par ce staff / celui reserve.
  oralSlotsOpened    WhitelistOralSlot[]     @relation("OralSlotOpener")
  oralSlotsBooked    WhitelistOralSlot[]     @relation("OralSlotBooker")

  // Systeme social (v1.0.5)
  friendshipsInitiated Friendship[]    @relation("FriendshipFrom")
  friendshipsReceived  Friendship[]    @relation("FriendshipTo")
  blockedUsers         UserBlock[]     @relation("BlockerRelation")
  blockedByUsers       UserBlock[]     @relation("BlockedRelation")
  sentMessages         DirectMessage[] @relation("MessageSender")
  receivedMessages     DirectMessage[] @relation("MessageReceiver")

  // Screenshots partagés (galerie sociale)
  shots                Shot[]
  shotLikes            ShotLike[]

  @@index([minecraftUuid])
  @@index([discordUserId])
  @@index([steamId])
}

enum Role {
  PLAYER
  WHITELISTED
  HELPER
  MODELISATEUR
  DEVELOPPEUR
  MODERATOR
  WHITELIST_REVIEWER
  ADMIN
  OWNER
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
}

// ──────────────────────────────────────────────────────
// WHITELIST
// ──────────────────────────────────────────────────────

model WhitelistApplication {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  // Statut global historique. Reste la source d'affichage legacy ; avec L5 il
  // devient derive : APPROVED seulement quand hrpStatus == rpStatus == APPROVED.
  status       AppStatus @default(PENDING)

  // L5 — prevalidation HRP (via test oral) puis validation RP, independantes.
  // HRP approuve = verrouille ; un RP rejete renvoie editer le RP seul.
  hrpStatus    AppStatus @default(PENDING)
  rpStatus     AppStatus @default(PENDING)

  // Etape 1 — HRP (hors roleplay)
  dob          DateTime
  motivation   String
  experience   String
  availability String

  // Etape 2 — RP (le personnage)
  firstName    String
  lastName     String
  village      String
  support      String?  // URL YouTube/Canva, optionnelle
  history      String
  appearance   String
  objectives   String

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewNotes  String?

  // Legacy : ID du thread Discord cree par le bot AVANT le passage au
  // flow DM (C3). Conserve pour les anciennes candidatures qui ont encore
  // leur thread, mais les nouvelles ne le settent plus.
  discordThreadId String?
  // Nouveau flow DM (C3) : ID du message public dans le salon staff
  // (avec bouton "Prendre en charge"). Le bot l'edite pour refleter le
  // claim / le statut.
  discordMessageId String?

  // Assignation staff : qui s'occupe de cette candidature, depuis quand.
  // Permet a la fois (a) d'eviter qu'un autre staff la traite en double
  // et (b) la mecanique d'escalation : si le user voit que personne ne
  // bouge depuis > 4h, il peut "demander une reprise" qui release ces
  // deux champs.
  assignedToUserId String?
  assignedTo       User?     @relation("WhitelistAssignee", fields: [assignedToUserId], references: [id])
  assignedAt       DateTime?

  messages     WhitelistMessage[]
}

// Conversation staff↔candidat liee a une candidature whitelist. Le canal
// physique reste un thread Discord ; cette table est la source de verite
// cote launcher (le user voit ses messages dans le launcher, le staff dans
// Discord). Le bot synchronise les deux sens via /webhooks/whitelist-message
// (user → discord) et /staff/whitelist/:id/messages (discord → user).
model WhitelistMessage {
  id            String              @id @default(uuid())
  applicationId String
  application   WhitelistApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorType    MessageAuthor
  // Pour USER : id du Reborn User. Pour STAFF : id Discord du staff qui a
  // poste dans le thread (snowflake). Pour SYSTEM : null.
  authorId      String?
  // Pseudonyme affichable (user.minecraftUsername ou Discord member.username).
  authorName    String?
  content       String
  // Liste de pieces jointes (URL Discord CDN ou data:URL relayee). On
  // garde simple : juste les URLs + nom + taille. Pas de stockage local.
  attachments   Json                @default("[]")
  // ID du message Discord d'origine (cote staff) ou copy poste par le bot
  // (cote user). Permet de dedup quand le bot s'auto-reproduit.
  discordMessageId String?
  createdAt     DateTime            @default(now())

  @@index([applicationId, createdAt])
}

enum MessageAuthor {
  USER
  STAFF
  SYSTEM
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

// L5 — etat d'un creneau oral de whitelist (pool global : le staff ouvre, le
// candidat reserve un creneau libre).
enum OralSlotStatus {
  OPEN       // ouvert, reservable
  BOOKED     // reserve par un candidat
  DONE       // oral passe (le staff a tranche l'HRP)
  CANCELLED  // annule par le staff
}

// Creneau de test oral (branche horaire de 30 min par defaut). Pool global :
// le staff ouvre des creneaux, tout candidat ayant soumis peut en reserver un
// libre. Une seule reservation active par candidat (garde en service).
model WhitelistOralSlot {
  id             String         @id @default(uuid())
  startAt        DateTime
  durationMin    Int            @default(30)
  status         OralSlotStatus @default(OPEN)

  openedByUserId String
  openedBy       User           @relation("OralSlotOpener", fields: [openedByUserId], references: [id])

  bookedByUserId String?
  bookedBy       User?          @relation("OralSlotBooker", fields: [bookedByUserId], references: [id])
  bookedAt       DateTime?

  notes          String?        // notes staff post-oral
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, startAt])
}

// ──────────────────────────────────────────────────────
// LAUNCHER RELEASES (auto-update Tauri)
// ──────────────────────────────────────────────────────

// Une entry par version × target. Le launcher poll GET /v1/launcher/update
// avec sa version courante + target (windows-x86_64 / darwin-aarch64 / ...)
// et l'API retourne la release la plus recente strictement superieure si
// elle existe, dans le format Tauri (version, pub_date, url, signature, notes).
//
// La signature Ed25519 base64 est generee localement par le maintainer via
// `pnpm tauri signer sign` apres le build NSIS, puis POSTee a /admin/releases
// par le panel staff (workflow doc dans docs/RELEASING.md).
model LauncherRelease {
  id          String   @id @default(uuid())
  version     String   // ex: "0.2.0"
  channel     String   @default("stable")
  target      String   // "windows-x86_64", "darwin-aarch64", "linux-x86_64"
  url         String   // URL absolue du binaire (NSIS .exe / .app.tar.gz / .AppImage)
  signature   String   // Signature Ed25519 base64 du binaire (cf tauri signer sign)
  notes       String?
  publishedAt DateTime @default(now())

  @@unique([version, target])
  @@index([target, channel, publishedAt])
}

// ──────────────────────────────────────────────────────
// MANIFEST & PATCH NOTES
// ──────────────────────────────────────────────────────

model Manifest {
  id                 String   @id @default(uuid())
  version            String   @unique
  minecraftVersion   String
  files              Json
  signature          String
  isCurrent          Boolean  @default(false)
  minLauncherVersion String
  // issuedAt + expiresAt sont les valeurs *exactes* signees dans le manifest.
  // Modifier ces valeurs apres signature invalide la signature, donc l'API
  // les retourne tels quels (pas de derivation).
  issuedAt           DateTime
  expiresAt          DateTime
  publishedAt        DateTime @default(now())

  @@index([isCurrent])
}

model PatchNote {
  id          String   @id @default(uuid())
  version     String
  title       String
  content     String
  thumbnail   String?
  publishedAt DateTime @default(now())
  pinned      Boolean  @default(false)
}

model Rules {
  id          String   @id @default(uuid())
  version     String   @unique
  content     String
  publishedAt DateTime @default(now())
  isCurrent   Boolean  @default(false)

  @@index([isCurrent])
}

model Lore {
  id          String   @id @default(uuid())
  version     String   @unique
  content     String
  publishedAt DateTime @default(now())
  isCurrent   Boolean  @default(false)

  @@index([isCurrent])
}

// ──────────────────────────────────────────────────────
// TICKETS
// ──────────────────────────────────────────────────────

model Ticket {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  category  TicketCategory
  subject   String
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  // Legacy : ID du thread Discord avant le flow DM (cf
  // WhitelistApplication.discordThreadId).
  discordThreadId String?
  // Nouveau flow DM (C3/C4) : message public dans le salon staff.
  discordMessageId String?

  // Cf WhitelistApplication.assignedTo* : meme mecanique de claim
  // staff + escalation 4h cote joueur.
  assignedToUserId String?
  assignedTo       User?     @relation("TicketAssignee", fields: [assignedToUserId], references: [id])
  assignedAt       DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum TicketCategory {
  BUG
  REPORT_PLAYER
  WHITELIST_APPEAL
  PURCHASE_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  MessageAuthor @default(USER)
  // Pour USER : id du Reborn User. Pour STAFF : snowflake Discord du staff.
  // Reste authorId pour backward compat avec le service existant qui pose
  // userId pour les messages user.
  authorId    String?
  authorName  String?
  content     String
  attachments Json          @default("[]")
  discordMessageId String?
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ──────────────────────────────────────────────────────
// SHOP
// ──────────────────────────────────────────────────────

model ShopProduct {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  description String
  priceCents  Int
  imageUrl    String
  category    String
  active      Boolean @default(true)
  metadata    Json?
}

model Purchase {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  productId   String
  amountCents Int
  status      PurchaseStatus @default(PENDING)
  provider    String
  providerRef String?
  createdAt   DateTime       @default(now())
  deliveredAt DateTime?
}

enum PurchaseStatus {
  PENDING
  PAID
  DELIVERED
  REFUNDED
  FAILED
}

// ──────────────────────────────────────────────────────
// SECURITE / AUDIT
// ──────────────────────────────────────────────────────

model IntegrityIncident {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  kind       String
  details    Json
  reportedAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actor        User     @relation("StaffActor", fields: [actorId], references: [id])
  action       String
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
  targetEntity String?
  metadata     Json
  ipAddress    String?
  userAgent    String?
  source       String
  createdAt    DateTime @default(now())

  // Hash chaine pour immutabilite (cf §14.5)
  previousHash String?
  hash         String   @unique

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model LoginAnomaly {
  id           String   @id @default(uuid())
  userId       String
  ipAddress    String
  country      String?
  reason       String
  acknowledged Boolean  @default(false)
  notifiedVia  String[]
  createdAt    DateTime @default(now())
}

// ──────────────────────────────────────────────────────
// EVENEMENTS RP
// ──────────────────────────────────────────────────────

model ScheduledEvent {
  id          String          @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  category    String
  factions    String[]
  visibility  EventVisibility @default(PUBLIC)
  createdAt   DateTime        @default(now())

  @@index([startsAt])
}

enum EventVisibility {
  PUBLIC
  WHITELISTED_ONLY
  FACTION_ONLY
}

// ──────────────────────────────────────────────────────
// SYSTEME SOCIAL (v1.0.5)
// ──────────────────────────────────────────────────────

model Friendship {
  id         String           @id @default(uuid())
  fromUserId String
  fromUser   User             @relation("FriendshipFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User             @relation("FriendshipTo", fields: [toUserId], references: [id])
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model DirectMessage {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User      @relation("MessageReceiver", fields: [receiverId], references: [id])
  content    String
  readAt     DateTime?
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}

// ──────────────────────────────────────────────────────
// SCREENSHOTS (galerie sociale — partage + feed)
// ──────────────────────────────────────────────────────

model Shot {
  id        String     @id @default(uuid())
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  filename  String // fichier stocké dans le dossier d'upload (servi via /uploads)
  caption   String?
  width     Int?
  height    Int?
  likeCount Int        @default(0)
  createdAt DateTime   @default(now())
  likes     ShotLike[]

  @@index([createdAt])
  @@index([authorId])
}

model ShotLike {
  shotId    String
  shot      Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([shotId, userId])
}

// ──────────────────────────────────────────────────────
// WIKI STAFF (base de connaissances Naruto + banque d'idees)
// ──────────────────────────────────────────────────────
// Base de connaissances taggee, cherchable, reservee au staff (builders,
// animateurs, MJ, modelisateurs) pour concevoir events/scenes/techniques et
// preparer les examens joueurs (genin/chunin). Plus un tableau d'idees.
//
// Decision : createdById / editedById sont des champs plats (id User Reborn)
// sans relation formelle vers User, pour eviter de toucher le modele User
// (disruption minimale). La seule relation croisee est intra-wiki
// (WikiIdea.linkedEntry -> WikiEntry).

enum WikiEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WikiIdeaStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  DONE
  REJECTED
}

enum WikiTagKind {
  SOURCE
  CANON
  TYPE
  AUDIENCE
}

model WikiTag {
  id        String      @id @default(uuid())
  kind      WikiTagKind
  label     String
  slug      String      @unique
  color     String?
  createdAt DateTime    @default(now())

  entries   WikiEntry[]

  @@index([kind])
}

model WikiEntry {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  summary     String?
  body        String          // markdown
  status      WikiEntryStatus @default(DRAFT)
  sources     String?         // references libres (URLs, tome/chapitre, databook...)
  createdById String?         // id User Reborn (champ plat, pas de relation formelle)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tags        WikiTag[]
  revisions   WikiRevision[]
  linkedIdeas WikiIdea[]      @relation("IdeaLinkedEntry")

  @@index([status])
  @@index([updatedAt])
}

model WikiRevision {
  id         String    @id @default(uuid())
  entryId    String
  entry      WikiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title      String
  summary    String?
  body       String
  editedById String?
  createdAt  DateTime  @default(now())

  @@index([entryId, createdAt])
}

model WikiIdea {
  id            String         @id @default(uuid())
  title         String
  body          String
  status        WikiIdeaStatus @default(PROPOSED)
  category      String?        // event / technique / build / system...
  linkedEntryId String?
  linkedEntry   WikiEntry?     @relation("IdeaLinkedEntry", fields: [linkedEntryId], references: [id])
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}
