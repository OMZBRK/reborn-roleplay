// Reborn Roleplay — schema Prisma
// Source de verite : PLAN_CONCEPTION_LAUNCHER.md §5.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  msAccountId       String   @unique
  minecraftUuid     String   @unique
  minecraftUsername String
  email             String?  @unique
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime?

  // Liaison Discord
  discordUserId     String?  @unique
  discordUsername   String?
  discordLinkedAt   DateTime?

  // Liaison Steam (optionnelle)
  steamId           String?  @unique
  steamUsername     String?
  steamLinkedAt     DateTime?

  // Liaison Twitch (optionnelle, pour streamers)
  twitchUserId      String?  @unique
  twitchUsername    String?
  twitchLinkedAt    DateTime?

  // Profil
  displayName       String?
  avatarUrl         String?

  // Preferences
  newsletterOptIn   Boolean  @default(false)
  notifEvents       Boolean  @default(true)
  notifFriends      Boolean  @default(true)
  notifTickets      Boolean  @default(true)
  richPresenceOn    Boolean  @default(true)
  language          String   @default("fr")

  // Marqueurs de lecture pour les compteurs non-lus (cloche + sidebar).
  // null = jamais consulté → tout est considéré comme non-lu.
  ticketsReadAt     DateTime?
  patchnotesReadAt  DateTime?

  // Monnaie premium (RBCoins, ADR 0006)
  rbCoinBalance     Int      @default(0)

  role              Role     @default(PLAYER)
  banned            Boolean  @default(false)
  banReason         String?
  bannedUntil       DateTime?

  // Candidature v2 et douane (docs/gameplay/CANDIDATURE_ET_DOUANE.md §2.9).
  // Ces deux dates vivent sur le compte, pas sur la candidature : elles
  // survivent au retrait (DELETE /whitelist/me supprime la ligne de candidature).
  /// Oral réussi (douane en jeu ou oral hors jeu). Renseigné = plus jamais d'oral, même après une nouvelle
  /// candidature (décision du 19/10 : l'oral à la première whitelist seulement).
  oralPassedAt        DateTime?
  /// Dernier refus (écrit ou oral). Nouvelle candidature possible 1 jour plus tard (canReapplyAt calculé).
  whitelistRejectedAt DateTime?

  // Securite
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  lastKnownIp       String?
  lastKnownCountry  String?

  whitelistApp      WhitelistApplication?
  tickets           Ticket[]
  purchases         Purchase[]
  sessions          Session[]
  incidents         IntegrityIncident[]
  staffActions      AuditLog[] @relation("StaffActor")
  targetedActions   AuditLog[] @relation("TargetUser")

  // Cas/tickets actuellement assignes a ce staff (cf C3/C4 — bot DM flow).
  assignedWhitelists WhitelistApplication[] @relation("WhitelistAssignee")
  assignedTickets    Ticket[]               @relation("TicketAssignee")

  // L5 — creneaux oraux de whitelist : ceux ouverts par ce staff / celui reserve.
  oralSlotsOpened    WhitelistOralSlot[]     @relation("OralSlotOpener")
  oralSlotsBooked    WhitelistOralSlot[]     @relation("OralSlotBooker")

  // Candidature v2 : brouillon serveur, oraux tranchés en tant qu'examinateur.
  candidatureBrouillon CandidatureBrouillon?
  oralExaminations     WhitelistApplication[] @relation("WhitelistOralExaminer")

  // Douane en jeu : séances ouvertes / examinées par ce staff, réservations du
  // candidat, passages tranchés en tant qu'examinateur.
  douaneSeancesOuvertes  DouaneSeance[]      @relation("DouaneSeanceOpener")
  douaneSeancesExaminees DouaneSeance[]      @relation("DouaneSeanceExaminateurs")
  douaneReservations     DouaneReservation[] @relation("DouaneReservationCandidat")
  douaneExamens          DouaneReservation[] @relation("DouaneReservationExaminateur")

  // Personnages du jeu, poussés par les serveurs (« Mes personnages », lot J).
  gameCharacters         GameCharacter[]

  // Systeme social (v1.0.5)
  friendshipsInitiated Friendship[]    @relation("FriendshipFrom")
  friendshipsReceived  Friendship[]    @relation("FriendshipTo")
  blockedUsers         UserBlock[]     @relation("BlockerRelation")
  blockedByUsers       UserBlock[]     @relation("BlockedRelation")
  sentMessages         DirectMessage[] @relation("MessageSender")
  receivedMessages     DirectMessage[] @relation("MessageReceiver")

  // Screenshots partagés (galerie sociale)
  shots                Shot[]
  shotLikes            ShotLike[]

  @@index([minecraftUuid])
  @@index([discordUserId])
  @@index([steamId])
}

enum Role {
  PLAYER
  WHITELISTED
  HELPER
  MODELISATEUR
  DEVELOPPEUR
  MODERATOR
  WHITELIST_REVIEWER
  ADMIN
  OWNER
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Famille de rotation : une connexion = une famille, chaque refresh la prolonge. Un replay ne révoque que sa
  /// famille (avant le 15/10 : toutes les sessions du compte, d'où des appareils qui se coupaient entre eux).
  /// Null = session antérieure au 15/10.
  familyId     String?

  @@index([familyId])
}

// ──────────────────────────────────────────────────────
// WHITELIST
// ──────────────────────────────────────────────────────

model WhitelistApplication {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  // Statut global. Candidature v2 (CANDIDATURE_ET_DOUANE.md §1.3) : APPROVED
  // seulement APRÈS l'oral (oralStatus APPROVED ou User.oralPassedAt). Écrit
  // validé (HRP + RP) mais oral à passer = PENDING + writtenApprovedAt.
  status       AppStatus @default(PENDING)

  // Les deux parties de l'ÉCRIT, tranchées au panel (v2). Avant la v2 (L5),
  // hrpStatus voulait dire « HRP validé via le test oral » : la migration
  // candidature_v2_douane en a tiré oralStatus.
  hrpStatus    AppStatus @default(PENDING)
  rpStatus     AppStatus @default(PENDING)

  /// 1 = ancien formulaire (ancien launcher, sans formVersion) ; 2 = candidature v2 en six onglets.
  /// Le DTO choisit ses règles d'après cette valeur (transition « A tolérant », §2.9).
  formVersion  Int       @default(1)

  // ── Partie HRP (onglet 1 « Vous ») ──
  /// v2 : âge déclaré du joueur, en nombre (15 à 99, borné par l'API).
  playerAge       Int?
  /// v1 seulement : date de naissance. Gardée pour les anciens dossiers, plus demandée en v2.
  dob             DateTime?
  rpYears         RpYears?
  narutoKnowledge NarutoKnowledge?
  /// Facultatif : null = « Pas de réponse ».
  discoverySource DiscoverySource?
  availability    String
  /// v1 seulement (« Pourquoi Reborn ? ») : retiré de la v2, l'oral en jeu le remplace (complément du 24/10).
  motivation      String?
  /// v1 seulement (« Ton expérience du roleplay ») : retiré de la v2 (complément du 24/10).
  experience      String?

  // ── Partie RP (onglets 2 « Personnage », 3 « Village », 4 « Histoire ») ──
  firstName     String
  /// v1 : texte libre, en pratique le clan. v2 : nom de famille LIBRE (3 à 20 lettres, jamais un nom de clan) ;
  /// aucun clan n'est choisi à la candidature, le premier personnage arrive « sans clan » (clan « Autre » du mod).
  lastName      String
  /// v2 : une des six valeurs exactes du mod (« Konohagakure »…), Déserteur exclu. v1 : texte libre.
  village       String
  characterType CharacterType?
  characterSex  CharacterSex?
  /// v2 : 10 à 60 ans, bornes du jeu.
  characterAge  Int?
  support       String?  // URL YouTube/Canva, optionnelle
  history       String
  /// v1 seulement (« Caractère et apparence ») : retiré de la v2 (complément du 24/10).
  appearance    String?
  objectives    String

  // ── Voix (onglet 5, partie RP) — fichier PRIVÉ, jamais servi en statique ──
  /// Nom du fichier dans le dossier privé des voix (hors /uploads public). Jamais une URL.
  /// null = aucune voix (v1) ou voix effacée (voiceDeletedAt).
  voiceKey         String?
  /// audio/webm ou audio/ogg (Content-Type renvoyé à l'écoute staff).
  voiceMimeType    String?
  /// Durée de l'enregistrement, en secondes (15 à 60).
  voiceDurationSec Int?
  voiceUploadedAt  DateTime?
  /// Effacement programmé : décision finale + 30 jours (Q2). Une tâche planifiée supprime le fichier.
  voicePurgeAt     DateTime?
  /// Fichier effacé (fin de la durée de garde) ; voiceKey est alors remis à null.
  voiceDeletedAt   DateTime?

  // ── Onglet 6 « Envoi » : cases cochées, datées ──
  /// « J'ai lu le règlement et ces réponses sont de moi ».
  rulesAcceptedAt DateTime?
  /// « J'accepte que ma voix soit enregistrée pour ma candidature ».
  voiceConsentAt  DateTime?

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  /// Commentaire de l'ÉCRIT, visible du joueur.
  reviewNotes  String?

  // ── Décision de l'écrit (v2) ──
  /// HRP et RP validés : le candidat peut réserver une séance de douane (status reste PENDING).
  writtenApprovedAt DateTime?
  /// Note PRIVÉE du staff sur l'écrit (points à creuser), transmise à l'examinateur. Jamais renvoyée au joueur.
  writtenStaffNotes String?

  // ── Décision de l'oral (v2) ──
  oralStatus         AppStatus @default(PENDING)
  oralDecidedAt      DateTime?
  /// Douane en jeu, ou oral hors jeu saisi au panel (transition §3.11, secours Q9).
  oralVia            OralVia?
  oralExaminerUserId String?
  oralExaminer       User?     @relation("WhitelistOralExaminer", fields: [oralExaminerUserId], references: [id])
  /// Motif de l'oral, VISIBLE du joueur (obligatoire pour « À revoir » et « Refusé »). Séparé de reviewNotes.
  oralReason         String?
  /// Notes PRIVÉES de l'examinateur. Jamais renvoyées au joueur.
  oralNotes          String?

  // Legacy : ID du thread Discord cree par le bot AVANT le passage au
  // flow DM (C3). Conserve pour les anciennes candidatures qui ont encore
  // leur thread, mais les nouvelles ne le settent plus.
  discordThreadId String?
  // Nouveau flow DM (C3) : ID du message public dans le salon staff
  // (avec bouton "Prendre en charge"). Le bot l'edite pour refleter le
  // claim / le statut.
  discordMessageId String?

  // Assignation staff : qui s'occupe de cette candidature, depuis quand.
  // Permet a la fois (a) d'eviter qu'un autre staff la traite en double
  // et (b) la mecanique d'escalation : si le user voit que personne ne
  // bouge depuis > 4h, il peut "demander une reprise" qui release ces
  // deux champs.
  assignedToUserId String?
  assignedTo       User?     @relation("WhitelistAssignee", fields: [assignedToUserId], references: [id])
  assignedAt       DateTime?

  messages            WhitelistMessage[]
  douaneReservations  DouaneReservation[]
  /// Personnage(s) issu(s) de cette candidature (marque `application` de ShinobiCore, §4.4).
  gameCharacters      GameCharacter[]
}

// ── Listes fermées de la candidature v2 (§2.3). Codes ASCII en base, libellés
// français côté launcher et panel.

/// « Depuis combien de temps fais-tu du roleplay ? »
enum RpYears {
  JAMAIS            // Jamais
  MOINS_D_UN_AN     // Moins d'un an
  UN_A_DEUX_ANS     // 1 à 2 ans
  TROIS_A_CINQ_ANS  // 3 à 5 ans
  SIX_ANS_ET_PLUS   // 6 ans et plus
}

/// « Ta connaissance de l'univers Naruto »
enum NarutoKnowledge {
  DEBUTANT            // Débutant
  QUELQUES_ARCS       // Quelques arcs
  BONNE_CONNAISSANCE  // Bonne connaissance
  INCOLLABLE          // Incollable, Boruto compris
}

/// « Comment as-tu découvert le serveur ? » (facultatif : null = Pas de réponse)
enum DiscoverySource {
  DISCORD
  TIKTOK
  YOUTUBE
  AMI            // Un ami
  AUTRE_SERVEUR  // Un autre serveur
  RECHERCHE      // Une recherche
  AUTRE
}

/// Type de personnage (Q3, décision du 24/10 : présent dès la beta).
enum CharacterType {
  NINJA
  CIVIL
}

/// Sexe du personnage. Valeurs du mod : « Homme », « Femme ».
enum CharacterSex {
  HOMME
  FEMME
}

/// Où l'oral a été passé.
enum OralVia {
  DOUANE    // en jeu, décision envoyée par le serveur
  HORS_JEU  // vocal ou appel, décision saisie au panel (transition, secours)
}

// Brouillon de candidature côté serveur (§2.5), à part de WhitelistApplication :
// il ne touche ni aux statuts ni au @unique de la candidature. Nom distinct du
// type TypeScript `WhitelistDraft` du launcher. `data` = le formulaire tel que
// le launcher l'envoie (contrôle souple, maximums appliqués, 256 Ko au plus).
// La voix envoyée avant l'envoi est rangée ici, dans des colonnes que seul
// l'endpoint d'upload écrit (jamais dans `data`, que le client réécrit) ; elle
// passe sur la candidature à l'envoi. Effacé après l'envoi ; pour une
// candidature « à revoir », il sert de zone d'édition des onglets rouverts.
model CandidatureBrouillon {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formVersion      Int       @default(2)
  data             Json      @default("{}")
  voiceKey         String?
  voiceMimeType    String?
  voiceDurationSec Int?
  voiceUploadedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Conversation staff↔candidat liee a une candidature whitelist. Le canal
// physique reste un thread Discord ; cette table est la source de verite
// cote launcher (le user voit ses messages dans le launcher, le staff dans
// Discord). Le bot synchronise les deux sens via /webhooks/whitelist-message
// (user → discord) et /staff/whitelist/:id/messages (discord → user).
model WhitelistMessage {
  id            String              @id @default(uuid())
  applicationId String
  application   WhitelistApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorType    MessageAuthor
  // Pour USER : id du Reborn User. Pour STAFF : id Discord du staff qui a
  // poste dans le thread (snowflake). Pour SYSTEM : null.
  authorId      String?
  // Pseudonyme affichable (user.minecraftUsername ou Discord member.username).
  authorName    String?
  content       String
  // Liste de pieces jointes (URL Discord CDN ou data:URL relayee). On
  // garde simple : juste les URLs + nom + taille. Pas de stockage local.
  attachments   Json                @default("[]")
  // ID du message Discord d'origine (cote staff) ou copy poste par le bot
  // (cote user). Permet de dedup quand le bot s'auto-reproduit.
  discordMessageId String?
  createdAt     DateTime            @default(now())

  @@index([applicationId, createdAt])
}

enum MessageAuthor {
  USER
  STAFF
  SYSTEM
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

// L5 — etat d'un creneau oral de whitelist (pool global : le staff ouvre, le
// candidat reserve un creneau libre).
enum OralSlotStatus {
  OPEN       // ouvert, reservable
  BOOKED     // reserve par un candidat
  DONE       // oral passe (le staff a tranche l'HRP)
  CANCELLED  // annule par le staff
}

// Creneau de test oral (branche horaire de 30 min par defaut). Pool global :
// le staff ouvre des creneaux, tout candidat ayant soumis peut en reserver un
// libre. Une seule reservation active par candidat (garde en service).
model WhitelistOralSlot {
  id             String         @id @default(uuid())
  startAt        DateTime
  durationMin    Int            @default(30)
  status         OralSlotStatus @default(OPEN)

  openedByUserId String
  openedBy       User           @relation("OralSlotOpener", fields: [openedByUserId], references: [id])

  bookedByUserId String?
  bookedBy       User?          @relation("OralSlotBooker", fields: [bookedByUserId], references: [id])
  bookedAt       DateTime?

  notes          String?        // notes staff post-oral
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, startAt])
}

// ──────────────────────────────────────────────────────
// DOUANE (oral en jeu) — CANDIDATURE_ET_DOUANE.md §3.3, §3.6, §3.9
// ──────────────────────────────────────────────────────
// Remplace WhitelistOralSlot (un candidat par créneau), qui sert encore pendant
// la transition. Le staff ouvre une SÉANCE avec une capacité ; le candidat dont
// l'écrit est validé y réserve une PLACE, avec une heure de convocation.

/// Ce que la séance examine. Seulement la whitelist : les candidatures de clan sont hors périmètre.
enum DouaneKind {
  WHITELIST
}

enum DouaneSeanceStatut {
  OUVERTE   // réservable dans la limite de la capacité
  FERMEE    // plus de nouvelle réservation, la séance a lieu
  TERMINEE  // clôturée par le staff (notes)
  ANNULEE   // annulée par le staff : les candidats sont prévenus
}

enum DouaneReservationStatut {
  BOOKED     // place réservée, à venir
  DONE       // passage tranché (voir resultat)
  MISSED     // séance manquée (au-delà de la fenêtre d'entrée) ; pas de limite pour la beta (Q12)
  CANCELLED  // annulée : par le candidat, par le staff, séance annulée ou reportée (motifAnnulation)
}

model DouaneSeance {
  id              String             @id @default(uuid())
  kind            DouaneKind         @default(WHITELIST)
  startAt         DateTime
  endAt           DateTime
  /// Nombre de places (réservations BOOKED ou DONE comptées). Repère : examinateurs × heures × 4.
  capacite        Int
  statut          DouaneSeanceStatut @default(OUVERTE)

  openedByUserId  String
  openedBy        User               @relation("DouaneSeanceOpener", fields: [openedByUserId], references: [id])
  /// Examinateurs prévus (staff du panel, rôle WHITELIST_REVIEWER ou plus).
  examinateurs    User[]             @relation("DouaneSeanceExaminateurs")

  /// Notes PRIVÉES du staff, à la clôture.
  notes           String?
  clotureeAt      DateTime?
  annuleeAt       DateTime?
  /// Motif d'annulation, transmis aux candidats prévenus.
  motifAnnulation String?

  reservations    DouaneReservation[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([statut, startAt])
  @@index([kind, startAt])
}

// Une place réservée dans une séance. Une seule réservation BOOKED par compte :
// garde en service (transaction), pas d'index partiel (Prisma ne le décrit pas).
model DouaneReservation {
  id                String                  @id @default(uuid())
  seanceId          String
  seance            DouaneSeance            @relation(fields: [seanceId], references: [id])
  applicationId     String
  application       WhitelistApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId            String
  user              User                    @relation("DouaneReservationCandidat", fields: [userId], references: [id])

  /// Heure de convocation H. Entrée en jeu permise de H − 15 min à H + 30 min (règle unique, §3.3).
  convocationAt     DateTime
  statut            DouaneReservationStatut @default(BOOKED)

  // Présence, remplie par le serveur de jeu (POST /game/douane/presence, lot facultatif).
  /// Arrivée au hall.
  presentAt         DateTime?
  /// Appelé au bureau par un examinateur.
  calledAt          DateTime?
  /// Sortie de la douane (déconnexion, fin de passage).
  departAt          DateTime?

  // Résultat du passage (l'état courant de l'oral vit sur WhitelistApplication).
  /// APPROVED, NEEDS_REVISION ou REJECTED ; null tant que rien n'est tranché.
  resultat          AppStatus?
  decidedAt         DateTime?
  examinateurUserId String?
  examinateur       User?                   @relation("DouaneReservationExaminateur", fields: [examinateurUserId], references: [id])

  /// Rappel 1 h avant envoyé (MP du bot + notification du launcher) : la tâche planifiée ne le renvoie pas.
  rappelEnvoyeAt    DateTime?
  annuleeAt         DateTime?
  /// Motif d'annulation (retiré de la douane, séance annulée, séance reportée, annulée par le candidat).
  motifAnnulation   String?

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([seanceId, statut])
  @@index([userId, statut])
  @@index([applicationId])
  @@index([statut, convocationAt])
}

/// Nonces à usage unique des routes signées du jeu (nouveau garde, §3.9 et §3.12) : un nonce déjà vu est
/// refusé. Les lignes plus vieilles que la fenêtre d'heure acceptée sont purgées par une tâche planifiée.
model GameRequestNonce {
  nonce     String   @id
  /// Serveur de jeu émetteur (identifiant de config, jamais une adresse).
  serverId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ──────────────────────────────────────────────────────
// PERSONNAGES DU JEU (CANDIDATURE_ET_DOUANE.md §4.5, lot J)
// ──────────────────────────────────────────────────────

/// Dernière photo d'un personnage de ShinobiCore, poussée par le serveur de jeu (POST /v1/game/characters/sync,
/// route signée). Le plugin fait foi : l'API ne crée ni ne modifie un personnage, elle garde la photo la plus
/// récente (`snapshotAt`). Chaque serveur numérote ses N° (player-ids.yml) : `serverId` entre dans les deux clés.
/// Le dev parle à la même API que la prod : ses personnages arrivent aussi en base, mais GET /v1/me/characters ne
/// lit que les serveurs de prod (REBORN_CHARACTERS_SERVER_IDS, `prod` par défaut).
model GameCharacter {
  id            String                @id @default(uuid())
  /// Serveur émetteur : `X-Reborn-Server`, prouvé par son secret, jamais lu dans le corps (« prod », « dev »…).
  serverId      String
  /// Identifiant du personnage côté plugin (ShinobiCharacter.id, UUID en minuscules).
  characterId   String
  /// Compte Minecraft propriétaire (ShinobiCharacter.ownerId), avec tirets, en minuscules.
  ownerMcUuid   String
  /// Compte Reborn du propriétaire, retrouvé par ownerMcUuid à chaque synchronisation ; null = compte inconnu.
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// N° (Player ID) attribué par le serveur, jamais réutilisé ; null tant qu'il n'est pas attribué. Montré au
  /// propriétaire (GET /me/characters) et au staff seulement, jamais dans un endpoint social ou public.
  playerId      Int?
  /// Prénom RP (modifiable en jeu, Q13).
  firstName     String
  /// Nom de famille libre (clan « Autre » du mod) ; null si le personnage n'en a pas.
  lastName      String?
  /// Clan acquis en session de clan ; null = sans clan (premier personnage, Q4).
  clan          String?
  /// Village RP, valeur du mod (« Konohagakure »…) ; null = aucun.
  village       String?
  /// Ninja ou civil (Q3) ; NINJA tant que le plugin n'envoie pas le type.
  type          CharacterType         @default(NINJA)
  /// Code du grade côté plugin (enum Rank : GENIN, CHUNIN…) ; le launcher affiche le libellé. null = aucun.
  rank          String?
  sex           CharacterSex?
  age           Int?
  /// Mort RP : le personnage reste sur le roster, grisé.
  dead          Boolean               @default(false)
  /// Supprimé en jeu : la ligne est gardée (état « Supprimé » dans « Mes personnages »).
  deletedAt     DateTime?
  /// Temps de jeu compté par le plugin depuis sa mise à jour ; le passé ne se reconstitue pas.
  playMinutes   Int                   @default(0)
  /// Création du personnage EN JEU (pas de la ligne) ; null si le plugin ne la connaît pas.
  createdAt     DateTime?
  /// Dernière partie avec ce personnage actif.
  lastSeenAt    DateTime?
  /// Candidature d'origine (marque `application` du YAML), premier personnage seulement (§4.4). Gardée seulement
  /// si elle appartient au même compte que le personnage.
  applicationId String?
  application   WhitelistApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  /// Instant de la photo côté plugin : une photo plus ancienne que celle en base est ignorée (file de reprise,
  /// envois croisés).
  snapshotAt    DateTime
  /// Première synchronisation reçue : début du décompte de playMinutes pour un personnage antérieur au suivi.
  firstSyncedAt DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([serverId, characterId])
  @@unique([serverId, playerId])
  @@index([userId, serverId])
  @@index([ownerMcUuid])
  @@index([applicationId])
}

// ──────────────────────────────────────────────────────
// LAUNCHER RELEASES (auto-update Tauri)
// ──────────────────────────────────────────────────────

// Une entry par version × target. Le launcher poll GET /v1/launcher/update
// avec sa version courante + target (windows-x86_64 / darwin-aarch64 / ...)
// et l'API retourne la release la plus recente strictement superieure si
// elle existe, dans le format Tauri (version, pub_date, url, signature, notes).
//
// La signature Ed25519 base64 est generee localement par le maintainer via
// `pnpm tauri signer sign` apres le build NSIS, puis POSTee a /admin/releases
// par le panel staff (workflow doc dans docs/operations/RELEASING.md).
model LauncherRelease {
  id          String   @id @default(uuid())
  version     String   // ex: "0.2.0"
  channel     String   @default("stable")
  target      String   // "windows-x86_64", "darwin-aarch64", "linux-x86_64"
  url         String   // URL absolue du binaire (NSIS .exe / .app.tar.gz / .AppImage)
  signature   String   // Signature Ed25519 base64 du binaire (cf tauri signer sign)
  notes       String?
  publishedAt DateTime @default(now())

  @@unique([version, target])
  @@index([target, channel, publishedAt])
}

// ──────────────────────────────────────────────────────
// MANIFEST & PATCH NOTES
// ──────────────────────────────────────────────────────

model Manifest {
  id                 String   @id @default(uuid())
  version            String   @unique
  minecraftVersion   String
  files              Json
  signature          String
  isCurrent          Boolean  @default(false)
  minLauncherVersion String
  // issuedAt + expiresAt sont les valeurs *exactes* signees dans le manifest.
  // Modifier ces valeurs apres signature invalide la signature, donc l'API
  // les retourne tels quels (pas de derivation).
  issuedAt           DateTime
  expiresAt          DateTime
  publishedAt        DateTime @default(now())

  @@index([isCurrent])
}

model PatchNote {
  id          String   @id @default(uuid())
  version     String
  title       String
  content     String
  thumbnail   String?
  publishedAt DateTime @default(now())
  pinned      Boolean  @default(false)
}

model Rules {
  id          String   @id @default(uuid())
  version     String   @unique
  content     String
  publishedAt DateTime @default(now())
  isCurrent   Boolean  @default(false)

  @@index([isCurrent])
}

model Lore {
  id          String   @id @default(uuid())
  version     String   @unique
  content     String
  publishedAt DateTime @default(now())
  isCurrent   Boolean  @default(false)

  @@index([isCurrent])
}

// ──────────────────────────────────────────────────────
// TICKETS
// ──────────────────────────────────────────────────────

model Ticket {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  category  TicketCategory
  subject   String
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  // Legacy : ID du thread Discord avant le flow DM (cf
  // WhitelistApplication.discordThreadId).
  discordThreadId String?
  // Nouveau flow DM (C3/C4) : message public dans le salon staff.
  discordMessageId String?

  // Cf WhitelistApplication.assignedTo* : meme mecanique de claim
  // staff + escalation 4h cote joueur.
  assignedToUserId String?
  assignedTo       User?     @relation("TicketAssignee", fields: [assignedToUserId], references: [id])
  assignedAt       DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum TicketCategory {
  BUG
  REPORT_PLAYER
  WHITELIST_APPEAL
  PURCHASE_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  MessageAuthor @default(USER)
  // Pour USER : id du Reborn User. Pour STAFF : snowflake Discord du staff.
  // Reste authorId pour backward compat avec le service existant qui pose
  // userId pour les messages user.
  authorId    String?
  authorName  String?
  content     String
  attachments Json          @default("[]")
  discordMessageId String?
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ──────────────────────────────────────────────────────
// SHOP
// ──────────────────────────────────────────────────────

model ShopProduct {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  description String
  priceCents  Int
  imageUrl    String
  category    String
  active      Boolean @default(true)
  metadata    Json?
}

model Purchase {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  productId   String
  amountCents Int
  status      PurchaseStatus @default(PENDING)
  provider    String
  providerRef String?
  createdAt   DateTime       @default(now())
  deliveredAt DateTime?
}

enum PurchaseStatus {
  PENDING
  PAID
  DELIVERED
  REFUNDED
  FAILED
}

// ──────────────────────────────────────────────────────
// SECURITE / AUDIT
// ──────────────────────────────────────────────────────

model IntegrityIncident {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  kind       String
  details    Json
  reportedAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actor        User     @relation("StaffActor", fields: [actorId], references: [id])
  action       String
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
  targetEntity String?
  metadata     Json
  ipAddress    String?
  userAgent    String?
  source       String
  createdAt    DateTime @default(now())

  // Hash chaine pour immutabilite (cf §14.5)
  previousHash String?
  hash         String   @unique

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model LoginAnomaly {
  id           String   @id @default(uuid())
  userId       String
  ipAddress    String
  country      String?
  reason       String
  acknowledged Boolean  @default(false)
  notifiedVia  String[]
  createdAt    DateTime @default(now())
}

// ──────────────────────────────────────────────────────
// EVENEMENTS RP
// ──────────────────────────────────────────────────────

model ScheduledEvent {
  id          String          @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  category    String
  factions    String[]
  visibility  EventVisibility @default(PUBLIC)
  createdAt   DateTime        @default(now())

  @@index([startsAt])
}

enum EventVisibility {
  PUBLIC
  WHITELISTED_ONLY
  FACTION_ONLY
}

// ──────────────────────────────────────────────────────
// SYSTEME SOCIAL (v1.0.5)
// ──────────────────────────────────────────────────────

model Friendship {
  id         String           @id @default(uuid())
  fromUserId String
  fromUser   User             @relation("FriendshipFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User             @relation("FriendshipTo", fields: [toUserId], references: [id])
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model DirectMessage {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User      @relation("MessageReceiver", fields: [receiverId], references: [id])
  content    String
  readAt     DateTime?
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}

// ──────────────────────────────────────────────────────
// SCREENSHOTS (galerie sociale — partage + feed)
// ──────────────────────────────────────────────────────

model Shot {
  id        String     @id @default(uuid())
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  filename  String // fichier stocké dans le dossier d'upload (servi via /uploads)
  caption   String?
  width     Int?
  height    Int?
  likeCount Int        @default(0)
  createdAt DateTime   @default(now())
  likes     ShotLike[]

  @@index([createdAt])
  @@index([authorId])
}

model ShotLike {
  shotId    String
  shot      Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([shotId, userId])
}

// ──────────────────────────────────────────────────────
// WIKI STAFF (base de connaissances Naruto + banque d'idees)
// ──────────────────────────────────────────────────────
// Base de connaissances taggee, cherchable, reservee au staff (builders,
// animateurs, MJ, modelisateurs) pour concevoir events/scenes/techniques et
// preparer les examens joueurs (genin/chunin). Plus un tableau d'idees.
//
// Decision : createdById / editedById sont des champs plats (id User Reborn)
// sans relation formelle vers User, pour eviter de toucher le modele User
// (disruption minimale). La seule relation croisee est intra-wiki
// (WikiIdea.linkedEntry -> WikiEntry).

enum WikiEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WikiIdeaStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  DONE
  REJECTED
}

enum WikiTagKind {
  SOURCE
  CANON
  TYPE
  AUDIENCE
}

model WikiTag {
  id        String      @id @default(uuid())
  kind      WikiTagKind
  label     String
  slug      String      @unique
  color     String?
  createdAt DateTime    @default(now())

  entries   WikiEntry[]

  @@index([kind])
}

model WikiEntry {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  summary     String?
  body        String          // markdown
  status      WikiEntryStatus @default(DRAFT)
  sources     String?         // references libres (URLs, tome/chapitre, databook...)
  createdById String?         // id User Reborn (champ plat, pas de relation formelle)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tags        WikiTag[]
  revisions   WikiRevision[]
  linkedIdeas WikiIdea[]      @relation("IdeaLinkedEntry")

  @@index([status])
  @@index([updatedAt])
}

model WikiRevision {
  id         String    @id @default(uuid())
  entryId    String
  entry      WikiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title      String
  summary    String?
  body       String
  editedById String?
  createdAt  DateTime  @default(now())

  @@index([entryId, createdAt])
}

model WikiIdea {
  id            String         @id @default(uuid())
  title         String
  body          String
  status        WikiIdeaStatus @default(PROPOSED)
  category      String?        // event / technique / build / system...
  linkedEntryId String?
  linkedEntry   WikiEntry?     @relation("IdeaLinkedEntry", fields: [linkedEntryId], references: [id])
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

enum ServerCommandStatus {
  PENDING
  DISPATCHED
  DONE
  FAILED
}

/// File d'attente de commandes console pour le serveur de jeu DEV. Le panel
/// enfile une commande WHITELISTÉE (ex. `nexo reload`) via l'endpoint reload
/// gaté JWT+role ; un pont côté ShinobiCore interroge l'API en sortant, exécute
/// la commande sur le thread principal et renvoie le résultat. Aucun port
/// entrant / RCON requis. Le `command` n'est jamais du texte libre : il est
/// résolu depuis une liste blanche côté API à l'enfilage.
model ServerCommand {
  id            String              @id @default(uuid())
  target        String // clé logique (nexo, magicspells, mythicmobs, modelengine)
  command       String // commande console résolue (whitelist), ex. "nexo reload"
  status        ServerCommandStatus @default(PENDING)
  output        String? // résultat renvoyé par le pont
  requestedById String // User Reborn qui a demandé le reload
  createdAt     DateTime            @default(now())
  dispatchedAt  DateTime?
  completedAt   DateTime?

  @@index([status, createdAt])
}

/// Un graphe de technique édité dans le panel (Technique Creator). Le `graph`
/// (JSON) est la SOURCE DE VÉRITÉ ; il compile (packages/ability-compiler) vers
/// abilities.yml + sorts MagicSpells / skills MythicMobs, poussés au serveur par
/// SFTP au déploiement. Le YAML n'est jamais édité à la main.
model TechniqueGraph {
  id          String              @id @default(uuid())
  slug        String              @unique // = id de la technique (lower_snake_case)
  name        String
  category    String              @default("")
  status      TechniqueGraphStatus @default(DRAFT)
  graph       Json // le graph.json (nodes + edges) validé par le schéma Zod
  createdById String?
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, updatedAt])
}

enum TechniqueGraphStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StaffDiscordChannel {
  ANNONCES
  DEV_UPDATES
  BUILD_UPDATES
}

enum StaffDiscordMessageStatus {
  DRAFT
  PUBLISHED
  REMOVED
}

/// Message rédigé dans le panel staff (page « Discord ») puis posté par le bot dans le salon
/// `annonces`, `dev-updates` ou `build-updates` du serveur Discord STAFF (route signée /webhooks/staff-message).
/// `blocs` = spec de cadre composants v2 (texte markdown, images, séparateur, liens), même format que
/// apps/bot/src/scripts/post-message.ts ; les images y sont citées par leur nom de média
/// (`<uuid>.<ext>`, stocké par l'API hors de /uploads public). Aucun ID Discord n'est versionné :
/// ceux stockés ici viennent des réponses du bot.
model StaffDiscordMessage {
  id               String                    @id @default(uuid())
  channel          StaffDiscordChannel
  status           StaffDiscordMessageStatus @default(DRAFT)
  title            String                    // dérivé du premier titre markdown (historique)
  color            String                    @default("#A0182B")
  blocks           Json
  ping             String                    @default("aucun") // aucun | testeurs | everyone
  discordMessageId String?
  discordChannelId String?
  discordUrl       String?
  previewMessageId String?                   // dernier aperçu posté dans le salon de test
  createdById      String                    // User Reborn (champ plat, cf. TechniqueGraph)
  createdByName    String
  updatedById      String?
  updatedByName    String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  publishedAt      DateTime?
  removedAt        DateTime?

  @@index([status, updatedAt])
  @@index([channel, createdAt])
}
