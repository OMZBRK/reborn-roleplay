{
  "schemaVersion": 1,
  "id": "reborn-integrity",
  "version": "${version}",
  "name": "Reborn Integrity",
  "description": "Atteste le client aupres du serveur Reborn via play-token signe par l'API. Aucune autre responsabilite (UI vit dans reborn-hud).",
  "authors": ["Reborn Team"],
  "contact": {
    "homepage": "https://reborn-rp.fr",
    "sources": "https://github.com/OMZBRK/reborn-roleplay"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["fr.reborn.integrity.RebornIntegrityClient"]
  },
  "mixins": [
    "reborn-integrity.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
