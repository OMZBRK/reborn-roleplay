{
  "schemaVersion": 1,
  "id": "reborn-hud",
  "version": "${version}",
  "name": "Reborn HUD",
  "description": "Repositionne librement les elements du HUD vanilla (chat, scoreboard, bossbar, action bar, etc.). Mode edit drag-and-drop, positions persistees.",
  "authors": ["Reborn Team"],
  "contact": {
    "homepage": "https://reborn-rp.fr",
    "sources": "https://github.com/OMZBRK/reborn-roleplay"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["fr.reborn.hud.RebornHudClient"]
  },
  "mixins": [
    "reborn-hud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
