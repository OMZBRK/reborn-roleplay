# Postgres (dev local)
POSTGRES_USER=reborn
POSTGRES_PASSWORD=reborn_dev_password_change_me
POSTGRES_DB=reborn
POSTGRES_PORT=5432

# Redis (dev local)
REDIS_PORT=6379

# DATABASE_URL utilisée par Prisma (apps/api)
DATABASE_URL=postgresql://reborn:reborn_dev_password_change_me@localhost:5432/reborn?schema=public

# Redis URL utilisée par l'API (sessions, queues, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# JWT (API) — generer une cle RS256 reelle pour la prod
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=reborn-rp
JWT_AUDIENCE=reborn-launcher

# Microsoft OAuth (Annexe A du plan)
MS_CLIENT_ID=
MS_REDIRECT_URI=http://localhost:53682/callback

# Discord (bot + OAuth)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Redirect URIs Discord (a enregistrer dans le Developer Portal)
# Linking launcher → API : http://localhost:3000/v1/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/v1/auth/discord/callback
# Login staff panel → API : http://localhost:3000/v1/auth/discord/staff/callback
DISCORD_STAFF_REDIRECT_URI=http://localhost:3000/v1/auth/discord/staff/callback

# Notifs "Claude Code a fini" (hook tools/claude-hooks/notify-discord.mjs).
# Renseigne l'UN des deux : ton user ID Discord pour recevoir un DM (recommande),
# ou un salon dedie. Vide les deux → le hook est branche mais rien n'est envoye.
# Pour trouver ton user ID : Discord → Parametres → Avance → Mode developpeur,
# puis clic droit sur ton profil → "Copier l'identifiant".
DISCORD_CLAUDE_NOTIFY_USER_ID=
DISCORD_CLAUDE_NOTIFY_CHANNEL_ID=

# Staff panel (apps/admin) — utilises par /auth/discord/staff/callback pour
# rediriger le navigateur vers la page de reception du token cote Next.js.
ADMIN_BASE_URL=http://localhost:3002
ADMIN_AUTH_CALLBACK_PATH=/auth/callback

# Steam (v1.0.5)
STEAM_API_KEY=

# Manifest Ed25519 (utiliser packages/manifest-signer pour generer)
MANIFEST_PRIVATE_KEY_PATH=./secrets/manifest_ed25519_private.pem
MANIFEST_PUBLIC_KEY_HEX=

# Play-token (attestation launcher → mod → plugin Guardian).
# Shared API ↔ plugin : l'API signe, le plugin Guardian verifie. Le launcher
# ne stocke pas ce secret. Generer 64+ chars random (openssl rand -base64 48).
REBORN_PLAY_TOKEN_SECRET=

# Tauri auto-updater — utilises uniquement par `pnpm launcher:build` pour
# signer automatiquement le binaire NSIS. Genere les cles via
# `pnpm launcher:sign-keys` (cf docs/RELEASING.md). Ne JAMAIS commit le
# fichier secrets/tauri-updater.key.
TAURI_SIGNING_PRIVATE_KEY=./secrets/tauri-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
