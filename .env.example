# Postgres (dev local)
POSTGRES_USER=reborn
POSTGRES_PASSWORD=reborn_dev_password_change_me
POSTGRES_DB=reborn
POSTGRES_PORT=5432

# Redis (dev local)
REDIS_PORT=6379

# DATABASE_URL utilisée par Prisma (apps/api)
DATABASE_URL=postgresql://reborn:reborn_dev_password_change_me@localhost:5432/reborn?schema=public

# Redis URL utilisée par l'API (sessions, queues, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# JWT (API) — generer une cle RS256 reelle pour la prod
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=reborn-rp
JWT_AUDIENCE=reborn-launcher

# Microsoft OAuth (Annexe A du plan)
MS_CLIENT_ID=
MS_REDIRECT_URI=http://localhost:53682/callback

# Discord (bot + OAuth)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Steam (v1.0.5)
STEAM_API_KEY=

# Manifest Ed25519 (utiliser packages/manifest-signer pour generer)
MANIFEST_PRIVATE_KEY_PATH=./secrets/manifest_ed25519_private.pem
MANIFEST_PUBLIC_KEY_HEX=

# Play-token (attestation launcher → mod → plugin Guardian).
# Shared API ↔ plugin : l'API signe, le plugin Guardian verifie. Le launcher
# ne stocke pas ce secret. Generer 64+ chars random (openssl rand -base64 48).
REBORN_PLAY_TOKEN_SECRET=
