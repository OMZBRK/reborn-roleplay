# Postgres (dev local)
POSTGRES_USER=reborn
POSTGRES_PASSWORD=reborn_dev_password_change_me
POSTGRES_DB=reborn
POSTGRES_PORT=5432

# Redis (dev local)
REDIS_PORT=6379

# DATABASE_URL utilisée par Prisma (apps/api)
DATABASE_URL=postgresql://reborn:reborn_dev_password_change_me@localhost:5432/reborn?schema=public

# Redis URL utilisée par l'API (sessions, queues, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# JWT (API) — generer une cle RS256 reelle pour la prod
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=reborn-rp
JWT_AUDIENCE=reborn-launcher

# Microsoft OAuth (Annexe A du plan)
MS_CLIENT_ID=
MS_REDIRECT_URI=http://localhost:53682/callback

# Discord (bot + OAuth)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Code de l'invitation publique du Discord des joueurs (la fin de discord.gg/<code>). L'API y lit
# le compteur membres / en ligne du launcher et du menu Echap (sans jeton). Vide = compteur
# indisponible ; regler l'invitation sur « n'expire jamais ». Cf CANDIDATURE_ET_DOUANE.md §5.2.
DISCORD_INVITE_CODE=Nw7jpjJ6dg
# Redirect URIs Discord (a enregistrer dans le Developer Portal)
# Linking launcher → API : http://localhost:3000/v1/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/v1/auth/discord/callback
# Login staff panel → API : http://localhost:3000/v1/auth/discord/staff/callback
DISCORD_STAFF_REDIRECT_URI=http://localhost:3000/v1/auth/discord/staff/callback

# Notifs "Claude Code a fini" (hook tools/claude-hooks/notify-discord.mjs).
# Renseigne l'UN des deux : ton user ID Discord pour recevoir un DM (recommande),
# ou un salon dedie. Vide les deux → le hook est branche mais rien n'est envoye.
# Pour trouver ton user ID : Discord → Parametres → Avance → Mode developpeur,
# puis clic droit sur ton profil → "Copier l'identifiant".
DISCORD_CLAUDE_NOTIFY_USER_ID=
DISCORD_CLAUDE_NOTIFY_CHANNEL_ID=

# Discord STAFF : annonces / dev / build updates rediges dans le panel (page « Discord »),
# postes par le bot (route signee /webhooks/staff-message). IDs copies depuis
# Discord (mode developpeur) ; jamais dans le depot. Cf docs/operations/DISCORD_STAFF.md §11.
DISCORD_STAFF_GUILD_ID=
DISCORD_STAFF_ANNONCES_CHANNEL_ID=
DISCORD_STAFF_DEVUPDATES_CHANNEL_ID=
DISCORD_STAFF_BUILDUPDATES_CHANNEL_ID=
# Optionnel : salon de test des apercus (vide = l'apercu ne poste rien).
DISCORD_STAFF_APERCU_CHANNEL_ID=
# Optionnel : role pinge par « @Testeur » (vide = role nomme « Testeur »).
DISCORD_STAFF_TESTEUR_ROLE_ID=

# Discord JOUEURS (« facon Ketto ») : accueil a chaque arrivee dans ⛩・bienvenue + salon piege
# (comptes pirates). Tout est optionnel ; vide = desactive. IDs copies depuis Discord (mode
# developpeur), jamais dans le depot. Cf docs/operations/DISCORD_JOUEURS.md §5.
DISCORD_JOUEURS_GUILD_ID=
DISCORD_BIENVENUE_CHANNEL_ID=
# Optionnels : emoji du pied (« <:reborn:ID> »), salon cite sous la banniere (nous-rejoindre),
# seuils anti-flood par minute (defauts 8 = regroupe, 25 = suspendu 10 min).
DISCORD_BIENVENUE_EMOJI=
DISCORD_BIENVENUE_COULEUR=
DISCORD_BIENVENUE_SEUIL_GROUPE=
DISCORD_BIENVENUE_SEUIL_RAID=
# Optionnels : salon staff du journal du bot, role Staff jamais sanctionne par le piege.
DISCORD_JOUEURS_LOG_CHANNEL_ID=
DISCORD_JOUEURS_STAFF_ROLE_ID=
# Salon piege ⚠️・ne-pas-ecrire : vide = desactive (defaut). Ban de N jours (defaut 7, 0 = definitif),
# messages effaces partout sur N secondes (defaut 3600), SIMULATION=1 = efface + journal, sans ban.
DISCORD_PIEGE_CHANNEL_ID=
DISCORD_PIEGE_JOURS=
DISCORD_PIEGE_PURGE_SECONDES=
DISCORD_PIEGE_SIMULATION=
# API, optionnels : dossier des images de ces messages (defaut <REBORN_UPLOAD_DIR>/.staff-media)
# et cle des URL signees (defaut derivee de JWT_SECRET).
REBORN_STAFF_MEDIA_DIR=
REBORN_MEDIA_SIGNING_SECRET=

# Staff panel (apps/admin) — utilises par /auth/discord/staff/callback pour
# rediriger le navigateur vers la page de reception du token cote Next.js.
ADMIN_BASE_URL=http://localhost:3002
ADMIN_AUTH_CALLBACK_PATH=/auth/callback

# Steam (v1.0.5)
STEAM_API_KEY=

# Manifest Ed25519 (utiliser packages/manifest-signer pour generer)
MANIFEST_PRIVATE_KEY_PATH=./secrets/manifest_ed25519_private.pem
MANIFEST_PUBLIC_KEY_HEX=

# Play-token (attestation launcher → mod → plugin Guardian).
# Shared API ↔ plugin : l'API signe, le plugin Guardian verifie. Le launcher
# ne stocke pas ce secret. Generer 64+ chars random (openssl rand -base64 48).
REBORN_PLAY_TOKEN_SECRET=

# Jeton de jeu : serveur visé et douane (docs/technique/PLUGINS_REFERENCE.md §5.4).
# En prod, ces variables passent par infra/docker-compose.prod.yml (déjà câblé).
# REBORN_SERVER_ID : claim « aud » par défaut, même valeur que server-id dans la config de
# Guardian (lettres minuscules, chiffres, tirets : prod, dev, build…).
# REBORN_SERVER_IDS : serveurs qu'un launcher peut demander, séparés par des virgules.
# Vides = pas de « aud » (ancien comportement).
REBORN_SERVER_ID=
REBORN_SERVER_IDS=
# REBORN_SERVER_ADDRESSES : adresse de jeu de chaque serveur, « id=hote:port » séparés par des virgules
# (ex. dev=<hote du dev>:25606,prod=<hote de la prod>:27106). Jointe au jeton : le launcher (0.3.49+)
# envoie le joueur à l'adresse du serveur visé (REBORN_SERVER_ID). Vide = adresse inscrite dans le launcher.
# Jamais d'adresse réelle dans le dépôt.
REBORN_SERVER_ADDRESSES=
# true = émet les jetons « douane » (candidats à l'oral) pour TOUS les serveurs.
# Vide = coupé. À activer seulement à l'étape 4 de la transition.
REBORN_DOUANE_ENABLED=
# Retard maximal après l'heure de convocation, en minutes (5 à 120 ; vide = 30). Vaut pour le
# bouton du launcher, le passage en « manquée » et le jeton. L'entrée ouvre toujours 15 min avant.
DOUANE_RETARD_MAX_MIN=

# Routes signées du serveur de jeu : GET /v1/game/acces/:mcUuid, /v1/game/douane/* et
# POST /v1/game/characters/sync (CANDIDATURE_ET_DOUANE.md §3.9, §3.12 et §4.5 ; contrat de signature :
# apps/api/src/game/game-signature.ts).
# Secret PROPRE au jeu, 32 caractères minimum, jamais celui du bot (REBORN_WEBHOOK_SECRET) ni du
# jeton de jeu (REBORN_PLAY_TOKEN_SECRET) : un secret égal à l'un d'eux est ignoré.
# Reco : un secret par serveur, REBORN_GAME_SECRETS="dev:<secret>,build:<secret>" (identifiant =
# server-id du serveur ; le même identifiant deux fois pendant un changement de secret).
# Sinon un seul secret pour tous les serveurs : REBORN_GAME_SECRET. REBORN_GAME_SECRETS passe avant.
# Les deux vides = routes coupées (503). Chaque serveur pose le sien de son côté (variable ou config).
REBORN_GAME_SECRET=
REBORN_GAME_SECRETS=
# « Mes personnages » du launcher (GET /v1/me/characters) : serveurs dont les personnages sont montrés,
# server-id de ShinobiCore séparés par des virgules. Vide = prod. Le dev est la pré-prod (il deviendra la
# prod) : depuis le 26/10 la prod de l'API lit « dev » ; à repasser sur le nouvel identifiant à la bascule.
REBORN_CHARACTERS_SERVER_IDS=

# Porte beta du launcher (CANDIDATURE_ET_DOUANE.md §3.10). LAUNCHER_BETA_GATE : rôle minimal admis à
# la connexion (ex. helper) ; vide = porte ouverte. LAUNCHER_BETA_ALLOW : comptes de test admis malgré
# la porte, pour essayer la candidature v2 et la douane avec de vrais comptes PLAYER (une seule API
# sert prod, dev et build). UUID Minecraft séparés par des virgules ; un pseudo est ignoré.
LAUNCHER_BETA_GATE=
LAUNCHER_BETA_ALLOW=

# Tauri auto-updater — utilises uniquement par `pnpm launcher:build` pour
# signer automatiquement le binaire NSIS. Genere les cles via
# `pnpm launcher:sign-keys` (cf docs/operations/RELEASING.md). Ne JAMAIS commit le
# fichier secrets/tauri-updater.key.
TAURI_SIGNING_PRIVATE_KEY=./secrets/tauri-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ─── Gestionnaire de fichiers panel staff (Phase 1 — serveur DEV) ───
# L'API se connecte en SFTP au serveur de jeu DEV (Minestrator) pour permettre
# aux grades Modelisateur (Nexo) / Developpeur (MagicSpells/MythicMobs/ModelEngine)
# de gerer les fichiers depuis panel.reborn-rp.com. Ces creds vivent UNIQUEMENT
# cote API (jamais le frontend). Toute action est journalisee dans l'AuditLog.
# REBORN_SFTP_BASE_PATH = racine "jail" (racine SFTP du serveur = "." par defaut).
REBORN_SFTP_HOST=
REBORN_SFTP_PORT=22
REBORN_SFTP_USER=
REBORN_SFTP_PASSWORD=
REBORN_SFTP_BASE_PATH=.
